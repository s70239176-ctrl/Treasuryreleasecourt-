# Chain to deploy to: "studionet" (61999) or "studio-dev" (61997)
CHAIN=studionet

# Private key of the deploying / steward account (Studio faucet-funded)
DEPLOYER_PRIVATE_KEY=0x...

# Charter text (optional — falls back to a sample dashboard charter)
CHARTER="The committee must ship a public dashboard reachable at a live URL."

# Recipients
BENEFICIARY_ADDRESS=0x...
TREASURY_ADDRESS=0x...

# Economics (GEN, decimal — converted to wei internally)
TRANCHE_GEN=10
APPEAL_BOND_GEN=2

# Demo-friendly windows (seconds)
SUBMISSION_WINDOW_SEC=300
APPEAL_WINDOW_SEC=180

# Committee: comma-separated addresses and matching kinds ("human"/"agent")
COMMITTEE_CSV=0xHumanAddress,0xAgentAddress
COMMITTEE_KINDS_CSV=human,agent
